library(GEOquery)
library(limma)
getwd()
gset <- getGEO("GSE268051", GSEMatrix = TRUE)
eset <- gset[[1]]
eset
expr <- exprs(eset)
dim(expr)
head(expr)
pheno <- pData(eset)
View(pheno)
write.csv(pheno,
          "Phenotype_information.csv")
colnames(pheno)
pheno$characteristics_ch1
summary(expr)
expr <- log2(expr + 1)
expr <- normalizeBetweenArrays(expr)
write.csv(expr,
          "Normalized_expression.csv")
boxplot(expr,
        outline=FALSE,
        las=2)
pdf("Boxplot.pdf")
boxplot(expr,
        outline=FALSE,
        las=2,
        col="skyblue")
dev.off()
group <- factor(c(
"Control",
"Control",
"Control",
"Control",
"Control",
"Disease",
"Disease",
"Disease",
"Disease",
"Disease"
))
design <- model.matrix(~0 + group)
colnames(design) <- levels(group)
design
fit <- lmFit(expr,
             design)
dim(expr)
dim(design)
colnames(expr)
ncol(expr)
nrow(design)
group <- factor(c(
  "Control",
  "Control",
  "Control",
  "Disease",
  "Disease",
  "Disease"
))
design <- model.matrix(~0 + group)
colnames(design) <- levels(group)
design
fit <- lmFit(expr, design)
contrast.matrix <- makeContrasts(
Disease-Control,
levels=design)
fit2 <- contrasts.fit(fit,
                      contrast.matrix)
fit2 <- eBayes(fit2)
results <- topTable(
fit2,
number=Inf,
adjust.method="BH")
head(results)
write.csv(results,
"Differential_expression_results.csv")
deg <- subset(results,
adj.P.Val < 0.05 &
abs(logFC) > 1)
nrow(deg)
save.image("GSE268051_analysis.RData")
q()
getwd()
load(GSE268051_analysis.RData)
ls()
objects()
dim(expr)
dim(design)
group <- factor(c(
  "Control",
  "Control",
  "Control",
  "Disease",
  "Disease",
  "Disease"
))
design <- model.matrix(~0 + group)
colnames(design) <- levels(group)

fit <- lmFit(expr, design)
library(limma)
fit <- lmFit(expr, design)
contrast.matrix <- makeContrasts(
  Disease - Control,
  levels = design
)
fit2 <- contrasts.fit(fit, contrast.matrix)
fit2 <- eBayes(fit2)
results <- topTable(fit2, number = Inf)
write.csv(results,
          "DEG_results.csv",
          row.names = TRUE)
deg <- subset(results,
              adj.P.Val < 0.05 &
              abs(logFC) > 1)

write.csv(deg,
          "Significant_DEGs.csv",
          row.names = TRUE)
write.csv(upregulated,
          "Upregulated_Genes.csv",
          row.names = TRUE)

write.csv(downregulated,
          "Downregulated_Genes.csv",
          row.names = TRUE)
write.csv(upregulated,
          "Upregulated_Genes.csv",
          row.names = TRUE)

write.csv(downregulated,
          "Downregulated_Genes.csv",
          row.names = TRUE)
# Upregulated genes
upregulated <- subset(deg, logFC > 1)

# Downregulated genes
downregulated <- subset(deg, logFC < -1)
write.csv(upregulated,
          "Upregulated_Genes.csv",
          row.names = TRUE)

write.csv(downregulated,
          "Downregulated_Genes.csv",
          row.names = TRUE)
nrow(upregulated)
nrow(downregulated)
nrow(deg)
summary(results$adj.P.Val)
deg <- subset(results, P.Value < 0.05 & abs(logFC) > 1)
upregulated <- subset(deg, logFC > 1)
downregulated <- subset(deg, logFC < -1)
sum(results$P.Value < 0.05)
nrow(deg)
summary(results$logFC)
range(results$logFC)
nrow(upregulated)
nrow(downregulated)
write.csv(upregulated,
          "Upregulated_Genes.csv",
          row.names = TRUE)

write.csv(downregulated,
          "Downregulated_Genes.csv",
          row.names = TRUE)
pdf("Volcano_Plot.pdf", width = 8, height = 6)

EnhancedVolcano(
  results,
  lab = rownames(results),
  x = "logFC",
  y = "P.Value"
)
library(EnhancedVolcano)
pdf("Volcano_Plot.pdf", width = 8, height = 6)

EnhancedVolcano(
  results,
  lab = rownames(results),
  x = "logFC",
  y = "P.Value"
)

library(EnhancedVolcano)

png("Volcano_Plot.png", width = 2000, height = 1600, res = 300)

EnhancedVolcano(
  results,
  lab = rownames(results),
  x = "logFC",
  y = "P.Value",
  pCutoff = 0.05,
  FCcutoff = 1,
  title = "Volcano Plot",
  subtitle = "GSE268051 Differential Expression Analysis"
)

dev.off()
library(pheatmap)

top50 <- rownames(deg)[1:min(50, nrow(deg))]

png("Heatmap.png", width = 2200, height = 2200, res = 300)

pheatmap(
  expr[top50, ],
  scale = "row",
  cluster_rows = TRUE,
  cluster_cols = TRUE,
  show_rownames = TRUE,
  show_colnames = TRUE,
  main = "Top 50 Differentially Expressed Genes"
)

dev.off()
library(limma)

top50 <- rownames(deg)[1:min(50, nrow(deg))]
heatmap_data <- expr[top50, ]

png("Heatmap.png", width = 2000, height = 2000, res = 300)

coolmap(
  heatmap_data,
  cluster.by = "de pattern",
  main = "Top 50 Differentially Expressed Genes"
)

dev.off()
# Select top 50 DEGs
top50 <- rownames(deg)[1:min(50, nrow(deg))]

# Extract expression values
heatmap_data <- expr[top50, ]

# Save as PNG
png("Heatmap.png", width = 2000, height = 2000, res = 300)

heatmap(
  heatmap_data,
  scale = "row",
  Colv = NA,
  col = colorRampPalette(c("blue", "white", "red"))(100),
  margins = c(8, 10),
  main = "Top 50 Differentially Expressed Genes"
)

dev.off()
png("Boxplot.png", width = 1800, height = 1400, res = 300)

boxplot(
  expr,
  col = "skyblue",
  las = 2,
  outline = FALSE,
  main = "Expression Distribution",
  xlab = "Samples",
  ylab = "Expression Value"
)

dev.off()
png("MA_Plot.png", width = 1800, height = 1400, res = 300)

plotMA(
  fit2,
  main = "MA Plot",
  ylim = c(-5,5)
)

dev.off()
png("MeanVariance_Trend.png", width = 1800, height = 1400, res = 300)

plotSA(fit2)

dev.off()
library(ggplot2)

pca <- prcomp(t(expr), scale. = TRUE)

pca_df <- data.frame(
  PC1 = pca$x[,1],
  PC2 = pca$x[,2],
  Group = group
)

png("PCA_Plot.png", width = 1800, height = 1400, res = 300)

ggplot(pca_df, aes(PC1, PC2, color = Group)) +
  geom_point(size = 4) +
  ggtitle("PCA Plot") +
  theme_classic()

dev.off()
save.image("GSE268051_analysis.RData2")
savehistory("GSE268051_DE_analysis.Rhistory")
