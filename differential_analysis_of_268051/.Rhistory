library(GEOquery)
library(limma)
getwd()
gset <- getGEO("GSE268051", GSEMatrix = TRUE)
eset <- gset[[1]]
eset
expr <- exprs(eset)
dim(expr)
head(expr)
pheno <- pData(eset)
View(pheno)
write.csv(pheno,
          "Phenotype_information.csv")
colnames(pheno)
pheno$characteristics_ch1
summary(expr)
expr <- log2(expr + 1)
expr <- normalizeBetweenArrays(expr)
write.csv(expr,
          "Normalized_expression.csv")
boxplot(expr,
        outline=FALSE,
        las=2)
pdf("Boxplot.pdf")

boxplot(expr,
        outline=FALSE,
        las=2,
        col="skyblue")

dev.off()
group <- factor(c(
"Control",
"Control",
"Control",
"Control",
"Control",
"Disease",
"Disease",
"Disease",
"Disease",
"Disease"
))
design <- model.matrix(~0 + group)

colnames(design) <- levels(group)

design
fit <- lmFit(expr,
             design)
dim(expr)
dim(design)
colnames(expr)
ncol(expr)
nrow(design)
group <- factor(c(
  "Control",
  "Control",
  "Control",
  "Disease",
  "Disease",
  "Disease"
))

design <- model.matrix(~0 + group)
colnames(design) <- levels(group)

design
fit <- lmFit(expr, design)
contrast.matrix <- makeContrasts(
Disease-Control,
levels=design)
fit2 <- contrasts.fit(fit,
                      contrast.matrix)

fit2 <- eBayes(fit2)
results <- topTable(
fit2,
number=Inf,
adjust.method="BH")
head(results)
write.csv(results,
"Differential_expression_results.csv")
deg <- subset(results,
adj.P.Val < 0.05 &
abs(logFC) > 1)
nrow(deg)
save.image("GSE268051_analysis.RData")
q()
